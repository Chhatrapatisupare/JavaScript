<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIT Nagpur - Computer Science & Engineering</title>
    <style>
        /* Base Reset and Styling */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        /* Card Container */
        .container {
            background-color: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            text-align: center;
            max-width: 500px;
            width: 90%;
            border-top: 5px solid #800020; /* Burgundy accent tone */
        }

        /* Typography */
        h1 {
            color: #800020;
            font-size: 24px;
            margin-bottom: 5px;
        }

        h2 {
            color: #555;
            font-size: 18px;
            font-weight: 500;
            margin-top: 0;
            margin-bottom: 25px;
        }

        p {
            font-size: 14px;
            color: #666;
            line-height: 1.5;
            margin-bottom: 30px;
        }

        /* Interactive Button */
        .btn-student-info {
            display: inline-block;
            background-color: #800020;
            color: #ffffff;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            text-decoration: none;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.1s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .btn-student-info:hover {
            background-color: #a30029;
        }

        .btn-student-info:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- College & Department Branding -->
        <h1>Symbiosis Institute of Technology, Nagpur</h1>
        <h2>Department of Computer Science & Engineering</h2>
        
        <p>Welcome to the official department portal. Click the button below to view student records and system logs.</p>
        
        <!-- The requested Student Info web link button -->
        <button class="btn-student-info" onclick="displayWelcomeMessage()">Student Info</button>
    </div>

    <!-- JavaScript Segment -->
    <script>
        // Log to browser developer tools (F12 -> Console) when the page finishes loading
        console.log("SIT Nagpur CSE Portal: JavaScript system initialized successfully.");

        // Function that triggers when the user clicks the "Student Info" button
        function displayWelcomeMessage() {
            // Internal log statement for troubleshooting
            console.log("User clicked the 'Student Info' action button.");
            
            // Displays the requested text in a browser popup window
            alert("Welcome to Sit Nagpur");
        }
    </script>

</body>
</html>
